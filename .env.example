# ============================================================
# AshenCourier —— docker compose 环境变量样例
# 用法：cp .env.example .env 后修改下面 3 个 required 的密钥
# ============================================================

# --- 必填：数据库口令 ---
POSTGRES_PASSWORD=change-me-postgres

# --- 必填：Redis 口令（compose 内强制 --requirepass） ---
REDIS_PASSWORD=change-me-redis

# --- 必填：JWT 签名密钥 ---
# 生成：openssl rand -base64 32
# 后端启动时会拒绝默认值 / 空值，避免生产裸奔
JWT_SECRET=

# --- 数据库连接串（容器内网地址） ---
DATABASE_URL=postgres://ashen:change-me-postgres@postgres:5432/ashen?sslmode=disable

# --- 对外基址：决定返回的 short_url 前缀与 CORS 允许来源 ---
PUBLIC_BASE_URL=http://localhost:8080

# --- 对外暴露端口（宿主 : 容器） ---
FRONTEND_PORT=8080

# --- 日志级别：debug | info | warn | error ---
LOG_LEVEL=info

# --- GeoIP 国家维度（可选，默认关闭）---
# 把 MaxMind DB 格式的国家库放进 ./deploy/geoip/，再指向**容器内**的 /geoip/<文件名>，
# 例如 GEOIP_DB_PATH=/geoip/dbip-country-lite.mmdb
# 留空（默认）= 点击明细的 country 字段一律为空，跳转与统计一切照旧。
# 库文件不入库（体积数 MB 且每月更新），下载方式与数据来源署名见 README「GeoIP 国家维度」。
GEOIP_DB_PATH=
