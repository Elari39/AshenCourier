# 统一以 LF 入库：迁移 SQL 与脚本在 Linux 容器里执行，
# 若带 CRLF 会导致 migrate 报语法错误 / entrypoint 出现 \r 报错
* text=auto eol=lf

*.sql   text eol=lf
*.sh    text eol=lf
Dockerfile text eol=lf

# Windows 本地脚本保留 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
