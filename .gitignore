# ============================================================
# AshenCourier .gitignore
#
# ⚠️ 有三样东西必须入库，任何情况下都不要加进忽略列表：
#   1. .env.example（两份：根目录与 frontend/）—— 新人照抄的模板
#   2. frontend/.npmrc —— 里面钉了实测选出的 registry 镜像源，
#      frontend/Dockerfile 会在 pnpm install 之前 COPY 它，
#      被忽略会导致镜像构建退回默认源（弱网下必超时）
#   3. frontend/pnpm-lock.yaml 与 backend/go.sum —— 可复现构建的前提
# ============================================================

# ------------------------------------------------------------
# 环境变量与密钥
# ------------------------------------------------------------
.env
.env.local
.env.*.local
*.env.local

# 模板文件要入库（放在忽略规则之后，用 ! 反向覆盖）
!.env.example

# ------------------------------------------------------------
# Go
# ------------------------------------------------------------
backend/bin/
backend/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.out
coverage.html

# Go 工作区（多模块时才需要，本项目单模块）
go.work
go.work.sum

# ------------------------------------------------------------
# Node / 前端
# ------------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
frontend/.vitest/
*.tsbuildinfo
.eslintcache
.prettiercache

# 包管理器日志
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ------------------------------------------------------------
# 编辑器 / IDE
# ------------------------------------------------------------
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# ------------------------------------------------------------
# 操作系统
# ------------------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini

# ------------------------------------------------------------
# Docker 本地覆盖
# ------------------------------------------------------------
docker-compose.override.yml
docker-compose.*.local.yml

# ------------------------------------------------------------
# 本地数据 / 导出
# ------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
dump/

# ------------------------------------------------------------
# 本地产物 / 临时文件
# ------------------------------------------------------------
*.log
*.local.md
tmp/
.tmp/

# WorkBuddy 的会话状态、工作区记忆与临时文件：
# 属于本地工具数据，不是项目产物
.workbuddy/
