# ============================================================
# 前端环境变量样例
#
# ⚠️ 只有 VITE_ 前缀的变量会打进前端产物，任何人都能从 JS 里读出来。
#    绝不要把任何密钥放进来。
#
# 本地开发（pnpm dev）时如需覆盖，复制成 .env.local。
# 生产构建不需要这两个变量：nginx 同源反代 /api，短链基址用 window.location.origin。
# ============================================================

# API 基址。留空/不设时用默认值 /api（同源反代）
# VITE_API_BASE_URL=/api

# 站点对外基址。留空时用 window.location.origin 展示短链
# VITE_PUBLIC_BASE_URL=http://localhost:8080
