# Merge into the existing HTTPS server in 1Panel; retain its certificate directives.
# Set Cloudflare TLS to Full (strict). Keep the origin firewall restricted to Cloudflare.
server_name shorten.miku831.fun;
include /etc/nginx/ashen-cloudflare-realip.conf;
real_ip_header CF-Connecting-IP;

location / {
    # Host OpenResty: http://127.0.0.1:8080
    # Shared Docker network: http://ashen-frontend:80
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host shorten.miku831.fun;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $request_id;
    proxy_cache off;
    proxy_intercept_errors off;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
}
